{
  "name": "hi-kid-fun-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.cjs",
    "dev": "tsx watch src/index.ts",
    "prebuild": "node scripts/check-node-version.cjs",
    "build": "tsc",
    "postbuild": "tsx src/scripts/generate-scenes-metadata.ts",
    "generate:quotes": "tsx src/scripts/generate-quotes.ts",
    "start": "node dist/index.js",
    "dev:worker": "npx wrangler dev --port 3001",
    "deploy": "npx wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.87.0"
  }
}
